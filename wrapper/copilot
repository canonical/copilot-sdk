#!/usr/bin/bash
# Runs Copilot CLI with its GitHub token from the workshop secret, if one is connected.
# Only this wrapper is on $PATH; the SDK's node and npm stay private.

sdk_dir=$(dirname "$(dirname "$(readlink -f "$0")")")

if [[ -z "${COPILOT_GITHUB_TOKEN:-}" ]]; then
  if token=$(workshopctl get-secret copilot.github-token 2>/dev/null) && [[ -n "$token" ]]; then
    export COPILOT_GITHUB_TOKEN="$token"
  fi
  unset token
fi

exec "$sdk_dir/bin/node" "$sdk_dir/lib/node_modules/@github/copilot/npm-loader.js" "$@"
