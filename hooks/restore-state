#!/usr/bin/bash
set -eu

# Replay the ~/.cache/copilot snapshot taken by save-state into the rebuilt
# workshop. Runs as root after setup-project; `cp -a` preserves source
# ownership, but we chown defensively in case any parent directories had to
# be created.
#
# ~/.copilot is NOT touched here — that path is covered by the
# copilot-config mount plug; see save-state for rationale.

CACHE_DST=/home/workshop/.cache/copilot
CACHE_SRC="$SDK_STATE_DIR/cache-copilot"

if [ -d "$CACHE_SRC" ]; then
    install -d -o workshop -g workshop "$CACHE_DST"
    cp -a "$CACHE_SRC/." "$CACHE_DST/"
    chown -R workshop:workshop "$CACHE_DST"
fi
