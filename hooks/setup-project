mkdir -p "$HOME/.copilot"

# Install the SDK's copilot-instructions.md only on first run. Once it
# exists — whether unchanged from the SDK or user-customised — refreshes
# leave it alone. To pull in an updated SDK prompt, delete the file and
# run `workshop refresh`.
if [[ ! -f "$HOME/.copilot/copilot-instructions.md" ]]; then
    install -m644 "${SDK}/workshop-prompt.md" "$HOME/.copilot/copilot-instructions.md"
fi
