#!/usr/bin/bash
set -eu

# Snapshot user-mutable Copilot state into $SDK_STATE_DIR so that
# `workshop refresh` doesn't force re-extraction of the 52MB JS bundle and
# doesn't drop any state that lives outside the copilot-config mount.
#
# What lives where (Copilot CLI 1.x):
#   ~/.copilot/         auth, history, MCP config, settings — already preserved
#                       across refresh by the `copilot-config` mount plug, but
#                       captured here too as a belt-and-suspenders guarantee.
#   ~/.cache/copilot/   self-extracted Node bundle (~50 MB), keyed by version.
#                       NOT inside any mount; wiped on refresh/restore without
#                       these hooks.

WORKSHOP_HOME=/home/workshop

snapshot() {
    local src="$1"
    local name="$2"
    local dst="$SDK_STATE_DIR/$name"
    if [ -d "$src" ]; then
        rm -rf "$dst"
        cp -a "$src" "$dst"
    fi
}

snapshot "$WORKSHOP_HOME/.copilot"       copilot
snapshot "$WORKSHOP_HOME/.cache/copilot" cache-copilot
