set -eu

# Snapshot ~/.cache/copilot — Copilot's self-extracted Node bundle (~52 MB,
# keyed by version) — into $SDK_STATE_DIR so it survives `workshop refresh`
# and `workshop restore`. Without this, every refresh would force the bundle
# to re-extract on next launch (~30 s latency).
#
# ~/.copilot is intentionally NOT snapshotted here. It is covered by the
# copilot-config mount plug across refresh / stop / start / restore.
# Duplicating mount-plug coverage with a state hook adds no value and risks
# the stale-snapshot-overwriting-live-data class of bug.

CACHE_SRC=/home/workshop/.cache/copilot
CACHE_DST="$SDK_STATE_DIR/cache-copilot"

if [ -d "$CACHE_SRC" ]; then
    rm -rf "$CACHE_DST"
    cp -a "$CACHE_SRC" "$CACHE_DST"
fi
